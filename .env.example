# 공개 클라이언트 설정. service_role/secret key를 VITE_ 변수에 넣지 않는다.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_COMMUNITY_EMAIL_CODE=false
VITE_COMMUNITY_SIGNUPS_READY=false
# 실제 상품·서버·구매/복원 테스트를 완료한 뒤에만 live로 전환한다.
VITE_SKYARD_MONETIZATION_MODE=preview
