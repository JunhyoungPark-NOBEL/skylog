{
  "name": "skylog",
  "version": "0.1.0-beta.16",
  "private": true,
  "description": "스카이야드 Skyard - 천체 관측 가이드",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:fetch": "tsx scripts/data/fetch.ts",
    "data:build": "tsx scripts/data/build.ts",
    "data:validate": "tsx scripts/data/validate.ts",
    "data:content": "tsx scripts/data/build-content.ts",
    "data:learn": "tsx scripts/data/build-learn.ts",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "build:native": "tsc -b && vite build --mode native",
    "mobile:sync": "pnpm build:native && cap sync",
    "test:community-db": "node tests/backend/community.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/share": "8.0.1",
    "@supabase/supabase-js": "2.116.0",
    "astronomy-engine": "^2.1.19",
    "dexie": "^4.4.5",
    "i18next": "^26.4.2",
    "katex": "0.18.7",
    "magvar": "2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "three": "^0.185.1",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
